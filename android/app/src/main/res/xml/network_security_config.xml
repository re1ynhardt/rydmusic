<?xml version="1.0" encoding="utf-8"?>
<!--
  just_audio на Android для передачи кастомных заголовков (см.
  AudioSource.uri(..., headers: ...) в audio_player_service.dart) поднимает
  собственный локальный HTTP-прокси на 127.0.0.1 и уже он добавляет
  заголовки перед реальным запросом к CDN. ExoPlayer ходит именно к этому
  локальному прокси по обычному http://, а начиная с Android 9
  (targetSdk 28+) cleartext-трафик (без TLS) заблокирован по умолчанию —
  отсюда и "CleartextNotPermittedException: Cleartext HTTP traffic to
  127.0.0.1 not permitted". Разрешаем cleartext только для локального
  прокси, а не для всего приложения целиком.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
